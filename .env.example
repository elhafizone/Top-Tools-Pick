DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXT_PUBLIC_SITE_URL="https://toptoolspick.com"
ADMIN_USERNAME="replace-with-admin-username"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Automated article generation (scripts/generate-articles.ts, /api/cron/generate-articles)
ANTHROPIC_API_KEY="replace-with-an-anthropic-api-key"
# Shared secret the Hostinger cron job must send to /api/cron/generate-articles.
CRON_SECRET="replace-with-a-long-random-secret"
# "true" publishes generated articles immediately; default (unset/"false") creates them as DRAFT for review in /admin/articles.
ARTICLE_AUTO_PUBLISH="false"

# Google Search Console reporting (/admin/seo) - see docs/seo/article-automation-setup.md
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL="replace-with-service-account-email"
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="replace-with-service-account-private-key"
GOOGLE_SEARCH_CONSOLE_SITE_URL="sc-domain:toptoolspick.com"
